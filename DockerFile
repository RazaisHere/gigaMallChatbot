# Use Python 3.11 slim image for smaller size
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies if needed (for psycopg2 and other compiled packages)
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories for runtime
RUN mkdir -p logs fileUploaded chromadb

# Expose port (Railway will provide PORT env var, default to 8080)
EXPOSE 8080

# Use Railway's PORT environment variable if available, otherwise default to 8080
# Railway automatically sets the PORT environment variable
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1
